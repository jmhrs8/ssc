<?php
require_once 'includes/header.php';

$mensajeExito = '';
$mensajeError = '';

// CREAR O EDITAR PRODUCTO
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['guardar_producto'])) {
        $id           = intval($_POST['id'] ?? 0);
        $nombre       = trim($_POST['nombre'] ?? '');
        $codigo       = trim($_POST['codigo'] ?? '');
        $tipoUnidad   = trim($_POST['tipo_unidad'] ?? 'pieza');
        $costoUnitario= floatval($_POST['costo_unitario'] ?? 0);
        $precioVenta  = floatval($_POST['precio_venta'] ?? 0);
        $stockMinimo  = floatval($_POST['stock_minimo'] ?? 0);
        $stockInicial = floatval($_POST['stock_actual'] ?? 0);

        if (!empty($nombre)) {
            try {
                if ($id > 0) {
                    // Editar
                    $stmt = $pdo->prepare("UPDATE productos SET nombre = ?, codigo = ?, tipo_unidad = ?, costo_unitario = ?, precio_venta = ?, stock_minimo = ? WHERE id = ?");
                    $stmt->execute([$nombre, $codigo, $tipoUnidad, $costoUnitario, $precioVenta, $stockMinimo, $id]);
                    $mensajeExito = "Producto actualizado correctamente.";
                } else {
                    // Nuevo
                    $stmt = $pdo->prepare("INSERT INTO productos (nombre, codigo, tipo_unidad, costo_unitario, precio_venta, stock_actual, stock_minimo) VALUES (?, ?, ?, ?, ?, ?, ?)");
                    $stmt->execute([$nombre, $codigo, $tipoUnidad, $costoUnitario, $precioVenta, $stockInicial, $stockMinimo]);
                    $mensajeExito = "Producto registrado con éxito.";
                }
            } catch (\PDOException $e) {
                $mensajeError = "Error al guardar el producto: " . $e->getMessage();
            }
        } else {
            $mensajeError = "El nombre del producto es obligatorio.";
        }
    }
}

// Cargar productos
try {
    $productos = $pdo->query("SELECT * FROM productos ORDER BY nombre ASC")->fetchAll(PDO::FETCH_ASSOC);
} catch (\PDOException $e) {
    $productos = [];
    $mensajeError = "Error al consultar catálogo: " . $e->getMessage();
}
?>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam text-primary me-2"></i> Catálogo de Productos</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalProducto0">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
    </button>
</div>

<?php if ($mensajeExito): ?>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <?= htmlspecialchars($mensajeExito) ?>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<?php endif; ?>

<?php if ($mensajeError): ?>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <?= htmlspecialchars($mensajeError) ?>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<?php endif; ?>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-table me-1"></i> Listado de Productos
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Unidad</th>
                        <th class="text-end">Costo U.</th>
                        <th class="text-end">Precio Venta</th>
                        <th class="text-center">Stock Actual</th>
                        <th class="text-center">Stock Mínimo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <?php if (empty($productos)): ?>
                        <tr><td colspan="8" class="text-center py-3 text-muted">No existen productos registrados.</td></tr>
                    <?php else: ?>
                        <?php foreach ($productos as $p): ?>
                            <?php $stockBajo = ($p['stock_actual'] <= $p['stock_minimo']); ?>
                            <tr>
                                <td><code><?= htmlspecialchars($p['codigo'] ?: 'S/C') ?></code></td>
                                <td class="fw-bold"><?= htmlspecialchars($p['nombre']) ?></td>
                                <td><?= htmlspecialchars($p['tipo_unidad']) ?></td>
                                <td class="text-end">$<?= number_format($p['costo_unitario'], 2) ?></td>
                                <td class="text-end text-success fw-bold">$<?= number_format($p['precio_venta'], 2) ?></td>
                                <td class="text-center">
                                    <span class="badge <?= $stockBajo ? 'bg-danger' : 'bg-success' ?> fs-6">
                                        <?= number_format($p['stock_actual'], 2) ?>
                                    </span>
                                </td>
                                <td class="text-center"><?= number_format($p['stock_minimo'], 2) ?></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalProducto<?= $p['id'] ?>">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODALES PARA NUEVO / EDITAR PRODUCTO -->
<?php 
$modalesList = array_merge([['id' => 0, 'nombre' => '', 'codigo' => '', 'tipo_unidad' => 'pieza', 'costo_unitario' => 0, 'precio_venta' => 0, 'stock_actual' => 0, 'stock_minimo' => 5]], $productos);
foreach ($modalesList as $item): 
    $esNuevo = ($item['id'] === 0);
?>
<div class="modal fade" id="modalProducto<?= $item['id'] ?>" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="productos.php">
                <input type="hidden" name="guardar_producto" value="1">
                <input type="hidden" name="id" value="<?= $item['id'] ?>">
                
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i> <?= $esNuevo ? 'Nuevo Producto' : 'Editar Producto' ?></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Producto (*):</label>
                        <input type="text" name="nombre" class="form-control" value="<?= htmlspecialchars($item['nombre']) ?>" required>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Código / SKU:</label>
                            <input type="text" name="codigo" class="form-control" value="<?= htmlspecialchars($item['codigo']) ?>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tipo Unidad:</label>
                            <select name="tipo_unidad" class="form-select">
                                <option value="pieza" <?= $item['tipo_unidad'] === 'pieza' ? 'selected' : '' ?>>Pieza</option>
                                <option value="kg" <?= $item['tipo_unidad'] === 'kg' ? 'selected' : '' ?>>Kilogramo (kg)</option>
                                <option value="metro" <?= $item['tipo_unidad'] === 'metro' ? 'selected' : '' ?>>Metro</option>
                                <option value="litro" <?= $item['tipo_unidad'] === 'litro' ? 'selected' : '' ?>>Litro</option>
                                <option value="caja" <?= $item['tipo_unidad'] === 'caja' ? 'selected' : '' ?>>Caja</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Costo Unitario ($):</label>
                            <input type="number" step="0.01" name="costo_unitario" class="form-control" value="<?= $item['costo_unitario'] ?>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Precio Venta ($):</label>
                            <input type="number" step="0.01" name="precio_venta" class="form-control" value="<?= $item['precio_venta'] ?>">
                        </div>
                    </div>

                    <div class="row g-2">
                        <?php if ($esNuevo): ?>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Stock Inicial:</label>
                                <input type="number" step="0.01" name="stock_actual" class="form-control" value="0">
                            </div>
                        <?php endif; ?>
                        <div class="col-md-<?= $esNuevo ? '6' : '12' ?>">
                            <label class="form-label fw-bold">Stock Mínimo (Alerta):</label>
                            <input type="number" step="0.01" name="stock_minimo" class="form-control" value="<?= $item['stock_minimo'] ?>">
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
<?php endforeach; ?>

<?php require_once 'includes/footer.php'; ?>

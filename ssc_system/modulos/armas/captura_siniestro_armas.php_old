<?php
session_start();
require_once "../../config/conexion.php";

$id = $_GET['id'] ?? null;
if (!$id) die("ID NO PROPORCIONADO");

$stmt = $pdo->prepare("SELECT a.*, e.* FROM inventario_armas a LEFT JOIN espejo_siniestros_armas e ON a.id = e.id_arma WHERE a.id = ?");
$stmt->execute([$id]);
$datos = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$datos) die("REGISTRO NO ENCONTRADO");
?>

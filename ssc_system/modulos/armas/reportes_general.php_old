<?php
require_once "../../config/conexion.php";

try {
    // 1. Estadísticas por Tipo de Bien
    $tipoBien = $pdo->query("SELECT tipo_bien, COUNT(*) as total FROM inventario_armas GROUP BY tipo_bien")->fetchAll(PDO::FETCH_ASSOC);

    // 2. Estadísticas por Estatus de Seguro (Pendientes, Proceso, Pagado, etc.)
    $statusSeguro = $pdo->query("SELECT status_seguro, COUNT(*) as total FROM inventario_armas GROUP BY status_seguro")->fetchAll(PDO::FETCH_ASSOC);

    // 3. Estadísticas por Estatus Interno (Para ver los PENDIENTES específicamente)
    $statusInterno = $pdo->query("SELECT status_interno, COUNT(*) as total FROM inventario_armas GROUP BY status_interno")->fetchAll(PDO::FETCH_ASSOC);

    // 4. Conteo de Accesorios Totales
    $totales = $pdo->query("SELECT 
        SUM(CAST(armas AS UNSIGNED)) as total_armas,
        SUM(CAST(cargador AS UNSIGNED)) as total_cargadores,
        SUM(CAST(cartuchos AS UNSIGNED)) as total_cartuchos,
        SUM(CAST(chalecos AS UNSIGNED)) as total_chalecos
        FROM inventario_armas")->fetch(PDO::FETCH_ASSOC);

} catch (PDOException $e) {
    die("Error en base de datos: " . $e->getMessage());
}
?>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reportes Armamento | SSC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <style>
        body { background-color: #f4f6f9; font-size: 13px; }
        .header-report { background: #1a1a1a; color: white; padding: 20px; border-bottom: 4px solid #0dcaf0; }
        .card { border: none; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .stat-card { border-left: 5px solid #0dcaf0; transition: 0.3s; }
        .stat-card:hover { transform: scale(1.02); }
    </style>
</head>
<body>

<div class="header-report mb-4">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0"><i class="fas fa-chart-bar me-2"></i> ESTADÍSTICAS Y ESTATUS: ARMAMENTO</h4>
            <p class="mb-0 text-info">Resumen de inventario y seguimiento de pendientes</p>
        </div>
        <a href="index.php" class="btn btn-outline-light btn-sm"><i class="fas fa-arrow-left"></i> VOLVER AL INVENTARIO</a>
    </div>
</div>

<div class="container-fluid">
    <div class="row mb-4 text-center">
        <div class="col-md-3">
            <div class="card stat-card bg-white p-3">
                <small class="text-muted fw-bold">ARMAS TOTALES</small>
                <h2 class="text-primary mb-0"><?= number_format($totales['total_armas'] ?? 0) ?></h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-white p-3" style="border-left-color: #198754;">
                <small class="text-muted fw-bold">CARGADORES</small>
                <h2 class="text-success mb-0"><?= number_format($totales['total_cargadores'] ?? 0) ?></h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-white p-3" style="border-left-color: #ffc107;">
                <small class="text-muted fw-bold">CARTUCHOS</small>
                <h2 class="text-warning mb-0"><?= number_format($totales['total_cartuchos'] ?? 0) ?></h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card bg-white p-3" style="border-left-color: #dc3545;">
                <small class="text-muted fw-bold">CHALECOS</small>
                <h2 class="text-danger mb-0"><?= number_format($totales['total_chalecos'] ?? 0) ?></h2>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card h-100">
                <div class="card-header bg-white fw-bold text-uppercase">
                    <i class="fas fa-tasks text-info me-2"></i> Seguimiento por Estatus Interno
                </div>
                <div class="card-body">
                    <canvas id="chartInterno" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-header bg-white fw-bold text-uppercase">
                    <i class="fas fa-shield-alt text-success me-2"></i> Estatus de Seguro
                </div>
                <div class="card-body">
                    <canvas id="chartSeguro"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header bg-white fw-bold text-uppercase">
                    <i class="fas fa-box text-primary me-2"></i> Inventario por Clasificación de Bien
                </div>
                <div class="card-body">
                    <canvas id="chartBienes" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    Chart.register(ChartDataLabels);

    const commonOptions = {
        responsive: true,
        plugins: {
            datalabels: {
                anchor: 'end',
                align: 'top',
                font: { weight: 'bold' },
                color: '#000'
            }
        }
    };

    // 1. GRÁFICA ESTATUS INTERNO (BARRAS)
    new Chart(document.getElementById('chartInterno'), {
        type: 'bar',
        data: {
            labels: [<?php foreach($statusInterno as $i) echo "'".($i['status_interno']?:'SIN ASIGNAR')."',"; ?>],
            datasets: [{
                label: 'Cantidad',
                data: [<?php foreach($statusInterno as $i) echo $i['total'].","; ?>],
                backgroundColor: '#0dcaf0'
            }]
        },
        options: commonOptions
    });

    // 2. GRÁFICA ESTATUS SEGURO (DONA)
    new Chart(document.getElementById('chartSeguro'), {
        type: 'doughnut',
        data: {
            labels: [<?php foreach($statusSeguro as $s) echo "'".($s['status_seguro']?:'SIN STATUS')."',"; ?>],
            datasets: [{
                data: [<?php foreach($statusSeguro as $s) echo $s['total'].","; ?>],
                backgroundColor: ['#198754', '#ffc107', '#dc3545', '#0d6efd', '#6c757d']
            }]
        },
        options: {
            plugins: {
                datalabels: { color: '#fff', font: { weight: 'bold' } }
            }
        }
    });

    // 3. GRÁFICA BIENES (BARRAS HORIZONTALES)
    new Chart(document.getElementById('chartBienes'), {
        type: 'bar',
        data: {
            labels: [<?php foreach($tipoBien as $b) echo "'".$b['tipo_bien']."',"; ?>],
            datasets: [{
                label: 'Total Registros',
                data: [<?php foreach($tipoBien as $b) echo $b['total'].","; ?>],
                backgroundColor: '#6610f2'
            }]
        },
        options: commonOptions
    });
</script>
</body>
</html>

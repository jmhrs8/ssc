<?php
require_once "../../config/conexion.php";
require_once "../../libs/fpdf/fpdf.php";

$folio = isset($_GET['folio']) ? trim($_GET['folio']) : '';
$stmt = $pdo->prepare("SELECT * FROM reporte_siniestro_detallado WHERE folio_siniestro = ? LIMIT 1");
$stmt->execute([$folio]);
$datos = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$datos) { die("ERROR: NO SE ENCONTRÓ EL FOLIO " . htmlspecialchars($folio)); }

$pdf = new FPDF('P', 'mm', 'Letter');
$pdf->SetAutoPageBreak(false);
$pdf->SetMargins(10, 10, 10);
$pdf->SetFillColor(235, 235, 235);
$pdf->AddPage();

// --- ENCABEZADO ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(0, 4, utf8_decode('CIUDAD DE MÉXICO | SECRETARÍA DE SEGURIDAD CIUDADANA | SSC-DGRMAYS'), 0, 1, 'L');

// MEJORA: Título con ancho controlado para no tocar el cuadro de fecha
$pdf->SetFont('Arial', 'B', 10);
$pdf->Cell(125, 10, utf8_decode('REPORTE TELEFÓNICO DE SINIESTRO'), 0, 0, 'L'); 

// Cuadro Fecha/Hora (Posición fija a la derecha)
$pdf->SetXY(140, 12);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(12, 4, 'DIA', 1, 0, 'C', true); 
$pdf->Cell(12, 4, 'MES', 1, 0, 'C', true);
$pdf->Cell(12, 4, utf8_decode('AÑO'), 1, 0, 'C', true); 
$pdf->Cell(12, 4, 'HORA', 1, 1, 'C', true);
$pdf->SetX(140);
$f = strtotime($datos['fecha'] ?? date('Y-m-d'));
$pdf->Cell(12, 5, date('d', $f), 1, 0, 'C');
$pdf->Cell(12, 5, date('m', $f), 1, 0, 'C');
$pdf->Cell(12, 5, date('Y', $f), 1, 0, 'C');
$pdf->Cell(12, 5, substr($datos['hora_reporte_aseg'] ?? '00:00', 0, 5), 1, 1, 'C');

// --- 1. DATOS DEL VEHÍCULO ---
$pdf->SetY(32); // Bajamos un poco para dar aire al encabezado
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(150, 5, utf8_decode('DATOS DEL VEHÍCULO ASEGURADO'), 1, 0, 'L', true);
$pdf->Cell(40, 5, 'FOLIO', 1, 1, 'L', true);

$pdf->SetFont('Arial', '', 6);
$y_v = $pdf->GetY();
$pdf->Cell(50, 7, 'MARCA: ' . mb_strtoupper(utf8_decode($datos['marca_espejo'] ?? '')), 1);
$pdf->Cell(50, 7, 'MODELO: ' . mb_strtoupper(utf8_decode($datos['modelo_espejo'] ?? '')), 1);
$pdf->Cell(50, 7, 'TIPO: ' . mb_strtoupper(utf8_decode($datos['tipo_espejo'] ?? '')), 1);

// Cuadro de Folio independiente
$pdf->SetXY(160, $y_v);
$pdf->SetFont('Arial', 'B', 11);
$pdf->Cell(40, 14, $datos['folio_siniestro'], 1, 0, 'C');

$pdf->SetXY(10, $y_v + 7);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(50, 7, 'ECONOMICO/PLACAS: ' . mb_strtoupper(utf8_decode($datos['economico_placas'] ?? '')), 1);

// Adscripción con MultiCell para que no choque con el Folio
$pdf->SetXY(60, $y_v + 7);
$pdf->MultiCell(100, 3.5, utf8_decode('ADSCRIPCIÓN: ') . mb_strtoupper(utf8_decode($datos['adscripcion_espejo'] ?? '')), 1, 'L');

$pdf->SetY($y_v + 14);
$pdf->Cell(60, 6, 'NUMERO DE INVENTARIO: ' . $datos['no_inventario_espejo'], 1);
$pdf->Cell(70, 6, 'SERIE Y/OR MOTOR: ' . mb_strtoupper($datos['no_serie_espejo']), 1);
$pdf->Cell(60, 6, 'KILOMETRAJE: ' . $datos['kilometraje_unidad'], 1, 1);

// --- 2. CONDUCTOR ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(190, 5, 'DATOS DEL CONDUCTOR', 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(63, 6, 'NOMBRE(S): ' . mb_strtoupper(utf8_decode($datos['cond_nombre'] ?? '')), 1);
$pdf->Cell(63, 6, 'A. PATERNO: ' . mb_strtoupper(utf8_decode($datos['cond_ap_paterno'] ?? '')), 1);
$pdf->Cell(64, 6, 'A. MATERNO: ' . mb_strtoupper(utf8_decode($datos['cond_ap_materno'] ?? '')), 1, 1);
$pdf->Cell(45, 6, 'N. EMPLEADO: ' . $datos['cond_no_empleado'], 1);
$pdf->Cell(45, 6, 'LICENCIA: ' . mb_strtoupper($datos['cond_licencia']), 1);
$pdf->Cell(50, 6, utf8_decode('TEL. ÁREA: ') . $datos['cond_tel_area'], 1);
$pdf->Cell(50, 6, 'TEL. PARTICULAR: ' . $datos['cond_tel_particular'], 1, 1);

// --- 3. QUIÉN REPORTA ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(190, 5, utf8_decode('QUIÉN REPORTA'), 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(190, 6, 'NOMBRE COMPLETO: ' . mb_strtoupper(utf8_decode($datos['quien_reporta_nombre'] ?? '')), 1, 1);

// --- 4. TERCERO ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(190, 5, 'DATOS DEL TERCERO', 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(45, 6, 'MARCA: ' . mb_strtoupper(utf8_decode($datos['tercero_marca_modelo'] ?? '')), 1);
$pdf->Cell(45, 6, 'MODELO/TIPO: ' . mb_strtoupper(utf8_decode($datos['tercero_tipo'] ?? '')), 1);
$pdf->Cell(50, 6, 'PLACAS: ' . mb_strtoupper($datos['tercero_placas'] ?? ''), 1);
$pdf->Cell(50, 6, 'COLOR: ' . mb_strtoupper(utf8_decode($datos['tercero_color'] ?? '')), 1, 1);

// --- 5. UBICACIÓN (MEJORA: Calle y Colonia en filas separadas para evitar encimado) ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(190, 5, utf8_decode('UBICACIÓN DEL ACCIDENTE'), 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(190, 6, 'CALLE(S): ' . mb_strtoupper(utf8_decode($datos['ubi_calle'] ?? '')), 1, 1); 
$pdf->Cell(130, 6, 'COLONIA: ' . mb_strtoupper(utf8_decode($datos['ubi_colonia'] ?? '')), 1, 0); 
$pdf->Cell(60, 6, utf8_decode('ALCALDÍA: ') . mb_strtoupper(utf8_decode($datos['ubi_alcaldia'] ?? '')), 1, 1);
$pdf->Cell(190, 6, 'REFERENCIAS: ' . mb_strtoupper(utf8_decode($datos['ubi_referencias'] ?? '')), 1, 1);

// --- 6. LESIONADOS ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(140, 5, 'LESIONADOS', 1, 0, 'L', true);
$pdf->Cell(50, 5, 'HOSPITAL', 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
for($i=1; $i<=3; $i++){
    $pdf->Cell(75, 6, 'NOMBRE: ' . mb_strtoupper(utf8_decode($datos["les_n$i"] ?? '')), 1);
    $pdf->Cell(45, 6, 'N. EMPLEADO: ' . ($datos["les_e$i"] ?? ''), 1);
    $pdf->Cell(20, 6, 'ERUM: ' . (($datos["les_er$i"] ?? 0) == 1 ? 'SI' : 'NO'), 1);
    $pdf->Cell(50, 6, mb_strtoupper(utf8_decode($datos["les_h$i"] ?? '')), 1, 1);
}

// --- 7. CONTROL OPERATIVO ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(190, 5, 'CONTROL OPERATIVO', 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(190, 6, 'SUPERVISOR: ' . mb_strtoupper(utf8_decode($datos['supervisor_nombre'] ?? '')), 1, 1);
$pdf->Cell(60, 6, 'TALLER: ' . mb_strtoupper(utf8_decode($datos['taller_nombre'] ?? '')), 1);
$pdf->Cell(40, 6, 'ASIGNADO: ' . ($datos['hora_asignado'] ?? ''), 1);
$pdf->Cell(45, 6, 'LLEGADA: ' . ($datos['hora_llegada'] ?? ''), 1);
$pdf->Cell(45, 6, 'TERMINADO: ' . ($datos['hora_terminado'] ?? ''), 1, 1);

// --- 8. ASEGURADORA ---
$pdf->SetFont('Arial', 'B', 7);
$pdf->Cell(190, 5, 'REPORTE A LA ASEGURADORA', 1, 1, 'L', true);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(120, 6, 'COORDINADOR: ' . mb_strtoupper(utf8_decode($datos['coord_aseguradora'] ?? '')), 1);
$pdf->Cell(70, 6, 'N. SINIESTRO: ' . mb_strtoupper($datos['no_siniestro_aseg'] ?? ''), 1, 1);
$pdf->Cell(120, 6, 'AJUSTADOR: ' . mb_strtoupper(utf8_decode($datos['ajustador_nombre'] ?? '')), 1);
$pdf->Cell(70, 6, utf8_decode('REPORTÓ A LAS: ') . ($datos['hora_reporte_aseg'] ?? ''), 1, 1);

// --- PIE DE PÁGINA 1 ---
$pdf->SetY(260);
$pdf->SetFont('Arial', 'B', 8);
$pdf->Cell(0, 5, utf8_decode('NOMBRE Y FIRMA DE LA/EL OPERADOR(A)'), 'T', 1, 'C');
$pdf->SetFont('Arial', '', 5);
$pdf->Text(10, 275, 'FO-SSC-07-DGRMAYS-04 V2.25');

// --- PÁGINA 2: OBSERVACIONES Y RIESGOS ---
$pdf->AddPage();
$pdf->SetFont('Arial', 'B', 8);
$pdf->Cell(0, 6, 'OBSERVACIONES', 0, 1);
$pdf->SetFont('Arial', '', 7);
$pdf->MultiCell(190, 6, mb_strtoupper(utf8_decode($datos['observaciones_generales'] ?? '')), 'B', 'L');
$currentY = $pdf->GetY();
while($currentY < 60){ $pdf->Cell(190, 6, '', 'B', 1); $currentY += 6; }

// Riesgo Afectado
$pdf->Ln(5);
$pdf->SetFont('Arial', 'B', 8);
$pdf->Cell(0, 5, 'RIESGO AFECTADO', 0, 1);
$pdf->SetFont('Arial', '', 6);
$pdf->Cell(130, 4, utf8_decode('(MARCAR CON UNA X LOS RIESGOS AFECTADOS Y ANOTAR LA ESTIMACIÓN DE DAÑOS)'), 0, 0);
$pdf->Cell(60, 4, utf8_decode('ESTIMACIÓN'), 0, 1, 'C');

$riesgos = [
    ['DAÑOS MATERIALES', 'riesgo_danos_materiales', 'est_danos_materiales'],
    ['ROBO TOTAL', 'riesgo_robo_total', 'est_robo_total'],
    ['RESPONSABILIDAD CIVIL', 'riesgo_resp_civil', 'est_resp_civil'],
    ['GASTOS MÉDICOS', 'riesgo_gastos_medicos', 'est_gastos_medicos'],
    ['EQUIPO ESPECIAL', 'riesgo_equipo_especial', 'est_equipo_especial']
];

foreach($riesgos as $r) {
    $pdf->SetX(40);
    $pdf->Cell(45, 6, utf8_decode($r[0]), 0);
    $pdf->Cell(15, 6, (($datos[$r[1]] ?? 0) == 1 ? '( X )' : '(   )'), 0);
    $pdf->Cell(10, 6, '$', 0);
    $pdf->Cell(50, 6, number_format((float)($datos[$r[2]] ?? 0), 2), 'B', 1, 'R');
}

// Responsable y Acta
$pdf->Ln(5);
$pdf->SetFont('Arial', 'B', 8);
$pdf->Cell(0, 5, utf8_decode('¿QUIÉN FUE EL RESPONSABLE?'), 0, 1);
$pdf->SetFont('Arial', '', 6);
$pdf->SetX(40);
$pdf->Cell(45, 6, utf8_decode('EL POLICÍA'), 0);
$pdf->Cell(15, 6, ($datos['resp_tipo'] == 'POLICIA' ? '( X )' : '(   )'), 0, 1);
$pdf->SetX(40);
$pdf->Cell(45, 6, utf8_decode('EL TERCERO'), 0);
$pdf->Cell(15, 6, ($datos['resp_tipo'] == 'TERCERO' ? '( X )' : '(   )'), 0, 1);
$pdf->SetX(40);
$pdf->Cell(45, 6, utf8_decode('SE LEVANTÓ ACTA'), 0);
$pdf->Cell(15, 6, (($datos['acta_levantada'] ?? 0) == 1 ? '( X )' : '(   )'), 0);
$pdf->Cell(30, 6, utf8_decode('NÚMERO DE ACTA'), 0);
$pdf->Cell(50, 6, mb_strtoupper($datos['no_acta'] ?? ''), 'B', 1);

// Deducible
$pdf->SetX(40);
$pdf->Cell(45, 6, 'APLICA DEDUCIBLE', 0);
$pdf->Cell(60, 6, 'SI ( '.($datos['aplica_deducible'] == 'SÍ' ? 'X' : ' ').' )    NO ( '.($datos['aplica_deducible'] == 'NO' ? 'X' : ' ').' )', 0, 1);

// Conclusión
$pdf->Ln(5);
$pdf->SetFont('Arial', 'B', 8);
$pdf->Cell(0, 5, utf8_decode('CÓMO CONCLUYÓ LA ATENCIÓN DEL SINIESTRO'), 0, 1);
$pdf->SetFont('Arial', '', 7);
$pdf->MultiCell(190, 6, mb_strtoupper(utf8_decode($datos['concluyo_atencion'] ?? '')), 'B', 'L');

$pdf->Output('I', "Reporte_Siniestro_" . $folio . ".pdf");

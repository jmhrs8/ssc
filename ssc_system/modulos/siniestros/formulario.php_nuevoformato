session_start();
require_once "../../config/conexion.php";

$id = $_GET['id'] ?? null;
$modo_edicion = ($id && $id !== 'nuevo');

if ($modo_edicion) {
    // MODO EDICIÓN: Cargar datos desde la tabla de siniestros
    $stmt = $pdo->prepare("SELECT * FROM siniestros WHERE id = ?");
    $stmt->execute([$id]);
    $r = $stmt->fetch(PDO::FETCH_ASSOC);
    if (!$r) die("Error: Siniestro no encontrado.");
} else {
    // MODO ALTA: Valores iniciales limpios y cálculo del consecutivo automático correcto
    $anio_actual = date('Y');

    // CORRECCIÓN DEFINITIVA: Ordenamos por el texto del folio de forma descendente 
    // para garantizar que el "003/2026" sea prioritario frente al "002/2026"
    $stmtFolio = $pdo->prepare("SELECT folio FROM siniestros WHERE folio LIKE ? ORDER BY folio DESC LIMIT 1");
    $stmtFolio->execute(["%/$anio_actual"]);
    $ultimo = $stmtFolio->fetch(PDO::FETCH_ASSOC);

    if ($ultimo) {
        // Extraemos los caracteres numéricos antes de la diagonal
        $partes = explode('/', $ultimo['folio']);
        $siguiente_numero = intval($partes[0]) + 1;
    } else {
        // Si de verdad es el primer registro que se genera en el año, inicia en 1
        $siguiente_numero = 1;
    }

    // Formato oficial rellenado con ceros a la izquierda (Ej: 001/2026, 002/2026)
    $folio_automatico = str_pad($siguiente_numero, 3, '0', STR_PAD_LEFT) . '/' . $anio_actual;

    $r = [
        'id' => '',
        'folio' => $folio_automatico,
        'fecha' => date('Y-m-d'),
        'hora' => date('H:i:s'),
        'marca' => '', 'modelo' => '', 'tipo' => '', 'economico_placas' => '',

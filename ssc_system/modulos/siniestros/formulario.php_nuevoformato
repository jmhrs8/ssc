        'ubi_alcaldia' => '', 'ubi_referencias' => '', 'supervisor' => '', 'taller_asignado' => '',
        'hora_asignado' => '', 'hora_llegada' => '', 'hora_terminado' => '',
        'aseguradora' => '', 'coord_aseguradora' => '', 'no_siniestro' => '', 'no_siniestro_aseg' => '',

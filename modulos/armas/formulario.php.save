


<?php
require_once "../../config/conexion.php";

$id = $_GET['id'] ?? null;
$d = [];

if ($id) {
    // Buscamos el registro por ID incluyendo los datos de la tabla espejo si existen
    $stmt = $pdo->prepare("
        SELECT g.*, e.nombre_resguardante, e.lugar_siniestro, e.narracion 
        FROM inventario_armas g
        LEFT JOIN espejo_siniestros_armas e ON g.id = e.id_arma
        WHERE g.id = ?
    ");
    $stmt->execute([$id]);
    $d = $stmt->fetch(PDO::FETCH_ASSOC);
}
?>


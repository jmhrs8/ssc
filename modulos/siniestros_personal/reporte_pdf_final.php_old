        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-primary"><i class="fas fa-hospital me-2"></i> HOSPITALES FRECUENTES</div>
                <div class="chart-container"><canvas id="chartHospital"></canvas></div>

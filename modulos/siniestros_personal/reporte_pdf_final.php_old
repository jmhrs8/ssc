    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <style>
        body { background: #fff; font-size: 11px; text-transform: uppercase; font-family: 'Segoe UI', sans-serif; color: #333; }

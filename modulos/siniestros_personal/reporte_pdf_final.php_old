        <!-- Gráfica de Tipos (Oficial, Civil, Comisionado, etc.) -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-danger"><i class="fas fa-id-badge me-2"></i> DISTRIBUCIÓN POR TIPO (OFICIAL / CIVIL / COMISIONADO)</div>
                <div class="chart-container-pie"><canvas id="chartTipo"></canvas></div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-warning"><i class="fas fa-exclamation-triangle me-2"></i> CAUSAS PRINCIPALES</div>
                <div class="chart-container"><canvas id="chartCausa"></canvas></div>
            </div>
